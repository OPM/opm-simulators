OIL
GAS
WATER

INCLUDE
 'include/comp_explicit_runspec.inc' /

GRID
INCLUDE
 'include/comp_explicit_grid.inc' /

PROPS
INCLUDE
 'include/comp_explicit_props.inc' /

INCLUDE
 'include/comp_explicit_water.inc' /

SOLUTION
