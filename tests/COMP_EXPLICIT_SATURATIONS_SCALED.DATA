 'include/comp_explicit_composition.inc' /

SOIL
 0.816 0.969 0.51 0.204 0.816 0.816 0.816 0.816 0 /

SWAT
 0.204 0.051 0.51 0.816 0.204 0.204 0.204 0.204 0.204 /

SGAS
 8*0 0.816 /

RPTRST
 BASIC=2 PRESSURE SGAS SOIL SWAT XMF YMF ZMF /

SCHEDULE
INCLUDE
 'include/comp_explicit_schedule.inc' /
END
