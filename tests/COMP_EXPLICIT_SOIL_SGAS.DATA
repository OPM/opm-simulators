-- SOIL and SGAS give water; no SWAT is supplied.

RUNSPEC
OIL
GAS
WATER

INCLUDE
 'include/comp_explicit_runspec.inc' /

GRID
INCLUDE
 'include/comp_explicit_grid.inc' /

PROPS
INCLUDE
 'include/comp_explicit_props.inc' /

INCLUDE
 'include/comp_explicit_water.inc' /

SOLUTION
INCLUDE
 'include/comp_explicit_composition.inc' /

SOIL
 0.8 0.95 0.5 0.2 0.8 0.8 0.8 0.8 0 /

SGAS
 8*0 0.8 /

RPTRST
 BASIC=2 PRESSURE SGAS SOIL SWAT XMF YMF ZMF /

SCHEDULE
INCLUDE
 'include/comp_explicit_schedule.inc' /
END
