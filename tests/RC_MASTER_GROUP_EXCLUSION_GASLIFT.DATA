-- Reservoir coupling master deck for the unit tests in
-- tests/rescoup/test_rescoup_constraints.cpp.  No slave is started: the test
-- sets the data the slaves would have reported, and the master group to slave
-- mapping that spawning the slaves would have set from GRUPMAST.  The deck must
-- be read with --parsing-strictness=low, as for a coupled run.
--
-- Group hierarchy:
--
--         FIELD (ORAT = 1000, LRAT = 2000, WATER RATE = 1000, GAS RATE = 1000)
--          /      |      |      |      \       \
--        M1      M2     M3     M4      P        S
--                                      |
--                                     W1
--
-- M1 and M2 are master groups of slave S1, M3 and M4 of slave S2.
-- M1, M2, M3: available for higher-level control (item 8 = YES), with guide
--             rates 100, 200, 300 for production and both injection phases.
-- M4:         not available for higher-level control (item 8 = NO), on its
--             own limits of 50.
-- P:          a plain group of the master itself, with the producer W1.  W1 has no
--             VFP table, and a lift gas rate (ALQ) of 86400 Sm3/day (1 Sm3/s).
-- S:          a satellite group (GSATPROD) with a lift gas supply of 43200 Sm3/day
--             (0.5 Sm3/s).
--
-- This deck is used to test the lift gas rates and headroom of the master, which
-- the other RC_MASTER_GROUP_EXCLUSION*.DATA decks have no wells or satellite groups
-- for.  Besides the groups P and S in GRUPTREE it adds the well W1 (WELSPECS, COMPDAT,
-- WCONPROD), the satellite group S (GSATPROD), and the gas lift keywords LIFTOPT and
-- WLIFTOPT.  The rest is in include/rc_master_group_exclusion_model.inc (the
-- one-cell model) and include/rc_master_group_exclusion_controls.inc (the slaves and
-- the group controls).
--
RUNSPEC

TITLE
RC_MASTER_GROUP_EXCLUSION_GASLIFT

INCLUDE
  'include/rc_master_group_exclusion_model.inc' /

-- =============================================================================
SCHEDULE
-- =============================================================================

GRUPTREE
 'M1' 'FIELD' /
 'M2' 'FIELD' /
 'M3' 'FIELD' /
 'M4' 'FIELD' /
 'P' 'FIELD' /
 'S' 'FIELD' /
/

-- A satellite group with a lift gas supply rate of 43200 Sm3/day (0.5 Sm3/s)
--  Group  Oil  Water  Gas  Resv  Lift_gas
GSATPROD
 'S'      0    0      0    0     43200 /
/

-- A producer without a VFP table, under a group of the master itself.  Its ALQ is a
-- lift gas rate in the input units (METRIC: Sm3/day).
--  Well  Group  I  J  Ref_depth  Phase
WELSPECS
 'W1'   'P'     1  1  2005       'OIL' /
/

--  Well  I  J  K1  K2  Status  Satnum  CF  Diameter
COMPDAT
 'W1'   1  1  1   1   'OPEN'  2*              0.2 /
/

--  Well  Status  Ctrl  Orate  Wrate Grate Lrate Resv  BHP  THP  VFP  Glift
WCONPROD
 'W1'   'OPEN'   'ORAT' 100    4*                        1*   1*   1*   86400 /
/

--  Increment
LIFTOPT
 12500.0 /

-- Maximum lift gas rate twice the ALQ, so that the headroom is the ALQ
--  Well  Optimize  Max_rate
WLIFTOPT
 'W1' 'YES' 172800 /
/

INCLUDE
  'include/rc_master_group_exclusion_controls.inc' /

TSTEP
1 /

END
