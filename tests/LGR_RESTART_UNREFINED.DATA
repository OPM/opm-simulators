-- MINPV removes every host cell of the only LGR, so the grid refines nothing.
-- The run must still write its restart file, with an empty section for the LGR.
RUNSPEC
DIMENS
 4 4 1 /
OIL
WATER
METRIC
START
 1 'JAN' 2020 /
EQLDIMS
/
TABDIMS
/
UNIFOUT
GRID
CARFIN
 'LGR1' 1 2 1 2 1 1 6 6 1 /
ENDFIN
DXV
 4*100.0 /
DYV
 4*100.0 /
DZ
 16*10.0 /
TOPS
 16*2000 /
PORO
 16*0.25 /
PERMX
 16*500 /
COPY
 PERMX PERMY /
 PERMX PERMZ /
/
BOX
 1 2 1 2 1 1 /
PORO
 4*0.001 /
ENDBOX
MINPV
 1000.0 /
PROPS
PVTW
 250.0 1.02 4.0E-05 0.5 0.0 /
ROCK
 250.0 4.0E-05 /
DENSITY
 850 1014 1.0 /
PVDO
 100.0 1.05 2.0
 250.0 1.02 2.5
 400.0 1.00 3.0 /
SWOF
 0.2 0.0  1.0 0.0
 0.8 0.5  0.0 0.0 /
SOLUTION
EQUIL
 2000 250.0 2100 0.0 /
SCHEDULE
RPTRST
 BASIC=2 /
TSTEP
 10 /
END
