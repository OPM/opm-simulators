-- Only SOIL is needed when water is inactive.

RUNSPEC
OIL
GAS

INCLUDE
 'include/comp_explicit_runspec.inc' /

GRID
INCLUDE
 'include/comp_explicit_grid.inc' /

PROPS
INCLUDE
 'include/comp_explicit_props.inc' /

SOLUTION
INCLUDE
 'include/comp_explicit_composition.inc' /

SOIL
 8*1 0.2 /

RPTRST
 BASIC=2 PRESSURE SGAS SOIL SWAT XMF YMF ZMF /

SCHEDULE
INCLUDE
 'include/comp_explicit_schedule.inc' /
END
