-- Test case for the summary of a run with an LGR.
-- A 3x3x1 grid whose centre cell is refined into 3x3x1.  The producer PROD
-- sits in the centre cell of the LGR and produces 100 STB/day of oil.
-- The summary requests field, well and block vectors and their LGR
-- counterparts (LW*, LC*, LB*).
-- Fluid and rock data from SPE1.

RUNSPEC

TITLE
LGR_SUMMARY

DIMENS
  3 3 1 /

EQLDIMS
/

TABDIMS
/

OIL
GAS
WATER
DISGAS

FIELD

START
  1 'JAN' 2015 /

WELLDIMS
  1 1 1 1 /

UNIFOUT

GRID

CARFIN
'LGR1'  2  2  2  2  1  1  3  3  1 /
ENDFIN

DX
  9*1000 /
DY
  9*1000 /
DZ
  9*50 /
TOPS
  9*8325 /
PORO
  9*0.3 /
PERMX
  9*500 /
PERMY
  9*500 /
PERMZ
  9*50 /

PROPS

PVTW
  4017.55 1.038 3.22E-6 0.318 0.0 /
ROCK
  14.7 3E-6 /
SWOF
  0.12  0        1      0
  0.36  7.44E-7  0.7    0
  0.72  4.65E-6  0.001  0
  1     0.00001  0      0 /
SGOF
  0     0      1      0
  0.05  0.005  0.980  0
  0.3   0.190  0.090  0
  0.88  0.984  0.000  0 /
DENSITY
  53.66 64.49 0.0533 /
PVDG
  14.700  166.666  0.008000
  1014.7  3.19700  0.014000
  4014.7  0.81100  0.026800
  9014.7  0.38600  0.047000 /
PVTO
  0.0010   14.7  1.0620  1.0400 /
  0.3710 1014.7  1.2950  0.8300 /
  1.2700 4014.7  1.6950  0.5100
         9014.7  1.5790  0.7400 /
  1.6180 5014.7  1.8270  0.4490
         9014.7  1.7370  0.6310 /
/

SOLUTION

EQUIL
  8400 4800 8450 0 8300 0 1 0 0 /
RSVD
  8300 1.270
  8450 1.270 /

SUMMARY

FOPR
FOPT
FPR
FOIP
FOE
WOPR
  'PROD' /
WBHP
  'PROD' /
BPR
  1 1 1 /
/
LWOPR
  'LGR1' 'PROD' /
/
LWBHP
  'LGR1' 'PROD' /
/
LCOPR
  'LGR1' 'PROD' 2 2 1 /
/
LBPR
  'LGR1' 2 2 1 /
/

SCHEDULE

WELSPECL
  'PROD' 'G1' 'LGR1' 2 2 1* OIL /
/
COMPDATL
  'PROD' 'LGR1' 2 2 1 1 OPEN 1* 1* 0.5 /
/
WCONPROD
  'PROD' OPEN ORAT 100.0 4* 1000.0 /
/

TSTEP
  2*10 /

END
